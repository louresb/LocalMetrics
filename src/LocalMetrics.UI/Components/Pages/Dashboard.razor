@page "/dashboard"
@using LocalMetrics.UI.Models
@using LocalMetrics.UI.Services
@using MudBlazor
@implements IAsyncDisposable
@inject MetricsService MetricsService

<h1 class="mb-4">Metrics dashboard</h1>

@if (_isLoading && _metrics is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else if (_metrics is null)
{
    <div class="alert alert-warning" role="alert">
        <h2 class="h5">The local API is unavailable</h2>
        <p class="mb-0">Start <code>LocalMetrics.Api</code> on port 5050. The dashboard will keep trying to reconnect.</p>
    </div>
}
else
{
    @if (!_isApiAvailable)
    {
        <div class="alert alert-warning" role="status">
            The API is unavailable. Showing the last sample from @(_lastSuccessfulAt?.ToLocalTime().ToString("T")).
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-4">
            <section class="p-4 shadow-sm rounded bg-white h-100">
                <h2 class="h5 fw-semibold">CPU usage</h2>
                <div style="height: @ChartHeight; width: 100%;">
                    <MudChart T="double"
                              ChartType="ChartType.Line"
                              ChartOptions="@_chartOptions"
                              ChartSeries="@_seriesCPU"
                              ChartLabels="@_timeLabels"
                              Height="@ChartHeight"
                              Width="@ChartWidth" />
                </div>
                <p class="fs-4 mt-2 mb-0">@($"{_metrics.CpuUsage:F2}%")</p>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="p-4 shadow-sm rounded bg-white h-100">
                <h2 class="h5 fw-semibold">Memory usage</h2>
                <div style="height: @ChartHeight; width: 100%;">
                    <MudChart T="double"
                              ChartType="ChartType.Line"
                              ChartOptions="@_chartOptions"
                              ChartSeries="@_seriesRam"
                              ChartLabels="@_timeLabels"
                              Height="@ChartHeight"
                              Width="@ChartWidth" />
                </div>
                <p class="fs-4 mt-2 mb-0">@($"{_metrics.RamUsage:F2}%")</p>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="p-4 shadow-sm rounded bg-white h-100">
                <h2 class="h5 fw-semibold">Disk usage</h2>
                <div style="height: @ChartHeight; width: 100%;">
                    <MudChart T="double"
                              ChartType="ChartType.Pie"
                              ChartOptions="@_chartOptions"
                              ChartSeries="@_seriesDisk"
                              ChartLabels="@_diskLabels"
                              Height="@ChartHeight"
                              Width="@ChartWidth" />
                </div>
                <p class="fs-4 mt-2 mb-0">@($"{_metrics.DiskUsage:F2}%")</p>
            </section>
        </div>
    </div>
}

@code {
    private const string ChartHeight = "200px";
    private const string ChartWidth = "100%";

    private SystemMetrics? _metrics;
    private PeriodicTimer? _timer;
    private Task? _refreshTask;
    private readonly CancellationTokenSource _cts = new();
    private readonly List<SystemMetrics> _history = [];
    private readonly ChartOptions _chartOptions = new();
    private readonly List<ChartSeries<double>> _seriesCPU = [new() { Name = "CPU" }];
    private readonly List<ChartSeries<double>> _seriesRam = [new() { Name = "Memory" }];
    private readonly List<ChartSeries<double>> _seriesDisk = [new()];
    private readonly string[] _diskLabels = ["Used", "Free"];
    private string[] _timeLabels = [];
    private bool _isLoading = true;
    private bool _isApiAvailable;
    private DateTime? _lastSuccessfulAt;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetricsAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _refreshTask = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadMetricsAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Expected during component disposal.
        }
    }

    private async Task LoadMetricsAsync()
    {
        try
        {
            var metric = await MetricsService.GetSystemMetricsAsync(_cts.Token);
            if (metric is not null)
            {
                _metrics = metric;
                _isApiAvailable = true;
                _lastSuccessfulAt = metric.Timestamp;
                _history.Add(metric);

                if (_history.Count > 20)
                    _history.RemoveAt(0);

                UpdateCharts();
            }
            else
            {
                _isApiAvailable = false;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Expected during component disposal.
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void UpdateCharts()
    {
        if (_metrics is null) return;

        _timeLabels = _history.Select(m => m.Timestamp.ToLocalTime().ToString("HH:mm:ss")).ToArray();
        _seriesCPU[0].Data = _history.Select(m => (double)m.CpuUsage).ToArray();
        _seriesRam[0].Data = _history.Select(m => (double)m.RamUsage).ToArray();
        _seriesDisk[0].Data = new[]
        {
            (double)_metrics.DiskUsage,
            100d - _metrics.DiskUsage
        };
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();

        if (_refreshTask is not null)
        {
            await _refreshTask;
        }

        _cts.Dispose();
    }
}
